---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentWarning from '@/components/ContentWarning.astro';
import { comic } from '@/config/comic';
---

<BaseLayout title="About" description={`About ${comic.title} and ${comic.author}.`}>
  <section class="about wrap">
    <span class="eyebrow">About</span>
    <h1>{comic.title}</h1>
    <p class="about__lead">{comic.aboutText}</p>

    <ContentWarning />

    {
      comic.social.length > 0 && (
        <>
          <h2>Elsewhere</h2>
          <ul class="about__social">
            {comic.social.map((link) => (
              <li>
                <a href={link.url} rel="me noopener">{link.label}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-6) var(--space-7);
    max-width: 38rem;
  }

  .about h1 {
    font-size: clamp(2.25rem, 6vw, 3rem);
    margin-block: var(--space-2) var(--space-4);
  }

  .about h2 {
    font-size: 1.1rem;
    margin-block: var(--space-6) var(--space-3);
  }

  .about__lead {
    color: var(--color-text-muted);
  }

  .about__social {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about__social a {
    color: var(--color-accent-bright);
    text-decoration: none;
  }

  .about__social a:hover {
    text-decoration: underline;
  }
</style>
