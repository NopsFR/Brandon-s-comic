---
import { comic } from '@/config/comic';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { href: `${base}read/`, label: 'Read' },
  { href: `${base}archive/`, label: 'Archive' },
  { href: `${base}about/`, label: 'About' },
];

function isActive(href: string) {
  return path === href || (href !== base && path.startsWith(href));
}
---

<header class="site-header">
  <div class="site-header__bar wrap">
    <a class="site-header__mark" href={base} aria-label={`${comic.title} — home`}>
      {comic.title}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="site-header__mobile">
      <summary aria-label="Open menu">
        <span aria-hidden="true">Menu</span>
      </summary>
      <ul class="site-header__mobile-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 9, 8, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__bar {
    max-width: 64rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }

  .site-header__mark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__mark:hover {
    color: var(--color-accent-bright);
  }

  .site-header__links {
    display: flex;
    gap: var(--space-5);
    list-style: none;
  }

  .site-header__links a {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }

  .site-header__links a:hover {
    color: var(--color-text);
  }

  .site-header__links a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .site-header__mobile {
    display: none;
  }

  @media (max-width: 640px) {
    .site-header__nav {
      display: none;
    }

    .site-header__mobile {
      display: block;
      position: relative;
    }

    .site-header__mobile summary {
      list-style: none;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      padding: var(--space-2) 0;
    }

    .site-header__mobile summary::-webkit-details-marker {
      display: none;
    }

    .site-header__mobile[open] summary {
      color: var(--color-text);
    }

    .site-header__mobile-links {
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: var(--space-2);
      list-style: none;
      background: var(--color-bg-raised);
      border: 1px solid var(--color-border);
      min-width: 10rem;
      padding: var(--space-2) 0;
    }

    .site-header__mobile-links a {
      display: block;
      padding: var(--space-2) var(--space-4);
      text-decoration: none;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }

    .site-header__mobile-links a:hover,
    .site-header__mobile-links a[aria-current='page'] {
      color: var(--color-text);
      background: var(--color-bg-inset);
    }
  }
</style>
